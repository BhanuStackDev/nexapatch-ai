GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
TARGET_REPO_PATH=.

# NexaPatch deployment authentication
# Keep development mode for local use. Internet-facing deployments must use production.
NEXAPATCH_ENV=development
# Required in production. Generate a strong random token and configure it privately on the backend.
NEXAPATCH_API_TOKEN=
